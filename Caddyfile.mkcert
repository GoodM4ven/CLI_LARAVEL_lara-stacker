# App sites (https://<app>.<domain>)
*.{$DOMAIN_SUFFIX} {
    @http protocol http
    redir @http https://{host}:{$CADDY_HTTPS_PORT}{uri} 308
    tls /etc/caddy/certs/localhost.pem /etc/caddy/certs/localhost-key.pem

    @vite header_regexp vite Host ^vite-([a-z0-9-]+)\.{$DOMAIN_SUFFIX}(?::\d+)?$
    handle @vite {
        reverse_proxy host.docker.internal:5173
    }

    @app header_regexp app Host ^([a-z0-9-]+)\.{$DOMAIN_SUFFIX}(?::\d+)?$
    handle @app {
        @disabled file /var/www/html/{http.regexp.app.1}/.disabled
        handle @disabled {
            respond "Project disabled" 503
        }

        root * /var/www/html/{http.regexp.app.1}/public
        php_fastcgi app:9000
        file_server
        encode zstd gzip
    }
}

# Optional service UIs
mailpit.{$DOMAIN_SUFFIX} {
    @http protocol http
    redir @http https://{host}:{$CADDY_HTTPS_PORT}{uri} 308
    tls /etc/caddy/certs/localhost.pem /etc/caddy/certs/localhost-key.pem
    reverse_proxy mailpit:8025
}

minio.{$DOMAIN_SUFFIX} {
    @http protocol http
    redir @http https://{host}:{$CADDY_HTTPS_PORT}{uri} 308
    tls /etc/caddy/certs/localhost.pem /etc/caddy/certs/localhost-key.pem
    reverse_proxy minio:9001
}

minio-api.{$DOMAIN_SUFFIX} {
    @http protocol http
    redir @http https://{host}:{$CADDY_HTTPS_PORT}{uri} 308
    tls /etc/caddy/certs/localhost.pem /etc/caddy/certs/localhost-key.pem
    reverse_proxy minio:9000
}
