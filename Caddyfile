{
    local_certs
}

# App sites (https://<app>.localhost)
*.localhost {
    @vite host_regexp vite ^vite-([a-z0-9-]+)\.localhost$
    handle @vite {
        reverse_proxy app:5173
    }

    @app host_regexp app ^([a-z0-9-]+)\.localhost$
    handle @app {
        @disabled file /var/www/html/{re.app.1}/.disabled
        handle @disabled {
            respond "Project disabled" 503
        }

        root * /var/www/html/{re.app.1}/public
        php_fastcgi app:9000
        file_server
        encode zstd gzip
    }
}

# Optional service UIs
mailpit.localhost {
    reverse_proxy mailpit:8025
}

minio.localhost {
    reverse_proxy minio:9001
}

minio-api.localhost {
    reverse_proxy minio:9000
}
