# App sites (https://<app>.dev.localhost)
*.dev.localhost {
    @http protocol http
    redir @http https://{host}:{$CADDY_HTTPS_PORT}{uri} 308
    tls /etc/caddy/certs/dev.localhost.pem /etc/caddy/certs/dev.localhost-key.pem

    root * /var/www/html

    @disabled_test {
        header_regexp disabledtest Host ^new-laravel-app-anew\.dev\.localhost(?::\d+)?$
        file /var/www/html/new-laravel-app-anew/.disabled
    }
    handle @disabled_test {
        respond "Application disabled (test)" 503
    }

    @disabled {
        header_regexp disabled Host ^([a-z0-9-]+)\.dev\.localhost(?::\d+)?$
        file {http.regexp.disabled.1}/.disabled
    }
    handle @disabled {
        respond "Application disabled" 503
    }

    @vite header_regexp vite Host ^vite-([a-z0-9-]+)\.dev\.localhost(?::\d+)?$
    handle @vite {
        reverse_proxy host.docker.internal:5173
    }

    @app header_regexp app Host ^([a-z0-9-]+)\.dev\.localhost(?::\d+)?$
    handle @app {
        root * /var/www/html/{http.regexp.app.1}/public
        php_fastcgi app:9000
        file_server
        encode zstd gzip
    }
}

# Service UIs
mailpit.dev.localhost {
    @http protocol http
    redir @http https://{host}:{$CADDY_HTTPS_PORT}{uri} 308
    tls /etc/caddy/certs/dev.localhost.pem /etc/caddy/certs/dev.localhost-key.pem
    reverse_proxy mailpit:8025
}

minio.dev.localhost {
    @http protocol http
    redir @http https://{host}:{$CADDY_HTTPS_PORT}{uri} 308
    tls /etc/caddy/certs/dev.localhost.pem /etc/caddy/certs/dev.localhost-key.pem
    reverse_proxy minio:9001
}

minio-api.dev.localhost {
    @http protocol http
    redir @http https://{host}:{$CADDY_HTTPS_PORT}{uri} 308
    tls /etc/caddy/certs/dev.localhost.pem /etc/caddy/certs/dev.localhost-key.pem
    reverse_proxy minio:9000
}
