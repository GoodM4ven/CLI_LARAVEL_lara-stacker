# App sites (https://<app>.dev.localhost)
*.dev.localhost {
    @http protocol http
    redir @http https://{host}:{$CADDY_HTTPS_PORT}{uri} 308
    tls /etc/caddy/certs/dev.localhost.pem /etc/caddy/certs/dev.localhost-key.pem
    @vite header_regexp vite Host ^vite-([a-z0-9-]+)\.dev\.localhost(?::\d+)?$
    handle @vite {
        reverse_proxy host.docker.internal:5173
    }

    @app header_regexp app Host ^([a-z0-9-]+)\.dev\.localhost(?::\d+)?$
    handle @app {
        root * /var/www/html/{http.regexp.app.1}
        try_files /.disabled /public/.disabled {path}
        @disabled path /.disabled /public/.disabled
        respond @disabled "Application disabled" 503

        # Keep Livewire request streaming uncompressed to avoid chunk coalescing.
        @compressed {
            not path /livewire/update
        }

        root * /var/www/html/{http.regexp.app.1}/public
        php_fastcgi lara-stacker-app-1:9000
        file_server
        encode @compressed zstd gzip
    }
}

# Service UIs
mailpit.dev.localhost {
    @http protocol http
    redir @http https://{host}:{$CADDY_HTTPS_PORT}{uri} 308
    tls /etc/caddy/certs/dev.localhost.pem /etc/caddy/certs/dev.localhost-key.pem
    reverse_proxy mailpit:8025
}

minio.dev.localhost {
    @http protocol http
    redir @http https://{host}:{$CADDY_HTTPS_PORT}{uri} 308
    tls /etc/caddy/certs/dev.localhost.pem /etc/caddy/certs/dev.localhost-key.pem
    reverse_proxy minio:9001
}

