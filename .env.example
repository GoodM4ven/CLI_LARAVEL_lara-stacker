USERNAME=<your-username>
DB_PASSWORD=<your-password>
APP_ROOT=/var/www/html
OPINIONATED=true
USE_VSC=true
VSC_WORKSPACES_DIR=/home/$USERNAME/Desktop

DOCKER_COMPOSE_FILE=./compose.yaml
# Comma-separated profiles: redis,mailpit,minio,postgres
DOCKER_PROFILES=redis,mailpit,minio
PHP_VERSION=8.3
NODE_VERSION=20
AUTO_TRUST_HTTPS=true
# HTTPS trust mode: caddy or mkcert
HTTPS_TRUST_MODE=caddy
APT_MIRROR=https://deb.debian.org
APT_SECURITY_MIRROR=https://security.debian.org
APT_PROXY=
INSTALL_MEDIA_TOOLS=true

# Tip: use 80/443 for Caddy if free on your host, for clean https://<app-name>.localhost URLs
CADDY_HTTP_PORT=8080
CADDY_HTTPS_PORT=8443
