USERNAME=<your-username>
DB_PASSWORD=<your-password>
HOST_HOME_PATH=/home/$USERNAME
APPS_ROOT=/home/$USERNAME/Code/Laravel
OPINIONATED=true
USE_VSC=true
VSC_WORKSPACES_DIR=/home/$USERNAME/Desktop

DOCKER_COMPOSE_FILE=./configurations/compose.yaml
RESTART_UNLESS_STOPPED=true
PHP_VERSION=8.3
APT_MIRROR=https://deb.debian.org
APT_SECURITY_MIRROR=https://security.debian.org

# Use 80/443 for Caddy if free on your host, for clean https://<app-name>.dev.localhost URLs
CADDY_HTTP_PORT=8080    # default 80
CADDY_HTTPS_PORT=8443   # default 443
MYSQL_PORT=3307         # default 3306
REDIS_PORT=6380         # default 6379
MAILPIT_SMTP_PORT=1026  # default 1025
MAILPIT_UI_PORT=8026    # default 8025
MINIO_PORT=9100         # default 9000
MINIO_CONSOLE_PORT=9101 # MinIO Console default 9001

# Tailscale Funnel entrypoint (local dev only). Generic across projects: the app
# served over the funnel is chosen by the `_funnel_app` symlink each project's funnel
# script creates under APPS_ROOT — no per-project TS_FUNNEL_APP needed here.
TS_FUNNEL_HOST=xyz.tailxxxxxx.ts.net
TS_FUNNEL_REVERB_PORT=8080
