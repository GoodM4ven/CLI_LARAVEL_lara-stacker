USERNAME=<your-username>
DB_PASSWORD=<your-password>
HOST_HOME_PATH=/Users/$USERNAME
APPS_ROOT=/Users/$USERNAME/Code/Laravel
# Removes MEMCACHED environment entries and adds default Prettier config.
OPINIONATED=true
# Editor integration for Xdebug files: "zed" (.zed/debug.json) or "none"; choose your own Zed debugger-start shortcut.
DEV_EDITOR=zed

DOCKER_COMPOSE_FILE=./configurations/compose.yaml
RESTART_UNLESS_STOPPED=true
# Keeps container PHP aligned with this repository's mise-managed PHP.
PHP_VERSION=8.4
CONTAINER_APT_MIRROR=https://deb.debian.org
CONTAINER_APT_SECURITY_MIRROR=https://security.debian.org

# Use 80/443 for Caddy if free on your host, for clean https://<app-name>.dev.localhost URLs
CADDY_HTTP_PORT=8080    # default 80
CADDY_HTTPS_PORT=8443   # default 443
MYSQL_PORT=3307         # default 3306
REDIS_PORT=6380         # default 6379
MAILPIT_SMTP_PORT=1026  # default 1025
MAILPIT_UI_PORT=8026    # default 8025
MINIO_PORT=9100         # default 9000
MINIO_CONSOLE_PORT=9101 # MinIO Console default 9001

# Optional Tailscale container. Generate an auth key in the Tailscale admin portal,
# enable Funnel for the tailnet, then use the "Tailscale > Funnel" CLI command.
TAILSCALE_AUTH_KEY=
TAILSCALE_HOSTNAME=lara-stacker
TAILSCALE_REVERB_PORT=8080
